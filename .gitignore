# 运行时数据(本地缓存,不入库)
data/
outputs/

# 用户配置(含 WxPusher SPT_TOKEN 等私密凭据,严禁入库)
# 模板见 config/defaults.json,首次启动会自动生成 config/user.json
config/user.json
user-docker.json
user*.json

# 临时文件/目录(测试缓存、下载中间文件等)
temp/

# Python
__pycache__/
*.pyc
*.pyo

# 虚拟环境 / 依赖
venv/
.venv/
env/

# 系统 / 编辑
.DS_Store
Thumbs.db
*.log

# IDE
.vscode/
.idea/

# 其他
*.sqlite3

# 凭据 / 环境变量
.env
.env.*
*.pem
*.key
secrets.json
