# 运行时数据(本地缓存,不入库)
data/
outputs/

# 用户配置(含 WxPusher SPT_TOKEN 等私密凭据,严禁入库)
# 模板见 config/defaults.json,首次启动会自动生成 config/user.json
config/user.json
user-docker.json
user*.json

# 用户自定义的 ETF -> 跟踪指数映射(属个人数据,模板即内置 INDEX_MAP)
# 放在 config/ 下但不入 user.json,理由见 core/index_valuation.py 顶部注释
config/index_map.json

# 本地归档(旧产物/临时脚本),不属于产品代码
archive/

# 临时文件/目录(测试缓存、下载中间文件等)
temp/

# 投资分析独立模块:配置(含 LLM 密钥)、中间数据、产物均不入库
invest/config/
invest/data/
invest/outputs/
invest/cache/

# Python
__pycache__/
*.pyc
*.pyo

# 虚拟环境 / 依赖
venv/
.venv/
env/

# 系统 / 编辑
.DS_Store
Thumbs.db
*.log

# IDE
.vscode/
.idea/

# 其他
*.sqlite3

# 凭据 / 环境变量
.env
.env.*
*.pem
*.key
secrets.json
